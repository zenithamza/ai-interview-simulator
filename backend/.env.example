# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ai-interview-simulator

# Server port
PORT=5000

# Groq API key (free) — get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# --- Auth ---
# Random long string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Google OAuth client ID — create one at https://console.cloud.google.com/apis/credentials
# (OAuth client type: "Web application"). Must match VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Email (used for OTP login codes + report emails) ---
# Any SMTP provider works. Quick options: Gmail app password, Mailtrap (dev/testing),
# SendGrid, Resend, Postmark. If left unset, emails are logged to the console instead
# of sent — useful for local development.
SMTP_HOST=smtp.example
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=Mockroom <no-reply@yourdomain.com>
